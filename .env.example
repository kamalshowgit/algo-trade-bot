# ============ ANGEL ONE BROKER CREDENTIALS ============
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_SECRET=your_totp_secret_here

# ============ EMAIL CONFIGURATION ============
# For Gmail: use App Passwords (not regular password)
# Enable 2FA first, then generate app password from: https://myaccount.google.com/apppasswords
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
RECIPIENT_EMAIL=recipient@email.com

# ============ TRADING CONFIGURATION ============
LIVE_MODE=false  # Set to 'true' for live trading, 'false' for backtesting
